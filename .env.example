# This is an environment variable file for Endurain's docker-compose.yml.example
# These are just the variable you have to set to be up and running.
# There is many more variable you could set. Check them out here: https://docs.endurain.com/getting-started/advanced-setup/#supported-environment-variables

# Local path for data persistence volumes. Defaults to /var/opt/endurain (FHS-compliant).
# Set this to an absolute path if you need to relocate data directories.
# LOCAL_PATH=/var/opt/endurain

# Set a strong password here. Check if there are no trailing whitespaces in the beginning and end. Must be the same as POSTGRES_PASSWORD
DB_PASSWORD=aee5c0d342f5a88dfe657bff3d21ddb31643cdbedd21177e20ec8524b15e3648
# Must be the same as DB_PASSWORD
POSTGRES_PASSWORD=aee5c0d342f5a88dfe657bff3d21ddb31643cdbedd21177e20ec8524b15e3648
SECRET_KEY=69b85208190c96821050d4ba980a8a95d928ab7e0ebf1a40b8ef6d09fd8367d3
FERNET_KEY=7NfMMRSCWcoNDSjqBX8WoYH9nTFk1VdQOdZY13po53Y=
TZ=Europe/Lisbon
ENDURAIN_HOST=https://endurain.example.com
BEHIND_PROXY=false
# BEHIND_PROXY=true requires TRUSTED_PROXIES: the container refuses to start without it.
# Comma-separated IPs, CIDR ranges or hostnames of your reverse proxy; never `*`.
# Uncomment one and set it to the address or name of your proxy:
# TRUSTED_PROXIES=10.0.0.5
# TRUSTED_PROXIES=192.168.0.0/16
# TRUSTED_PROXIES=caddy
# Deployment shape: `local` (default; single process, in-memory state) or
# `distributed` (multi-node; requires shared state via Redis). See the docs.
## Shared Redis DSN for all ephemeral state (rate-limit counters, auth lockout,
# pending-MFA, MFA setup secrets, Garmin MFA codes, websocket tickets).
# Required for `distributed` or WEB_WORKERS>1; optional for `local`.
# STATE_URI overrides this if you want state on a different backend.
#REDIS_URL=redis://redis:6379/0

# Optional: Exact redirect addresses mobile apps may pass as the `redirect` query parameter when
# initiating SSO via the system browser. The default is the Endurain mobile app's callback.
# Setting it replaces the default, so keep com.endurain.endurain:/auth/sso/callback in the list.
# Example: ALLOWED_REDIRECT_URIS=com.endurain.endurain:/auth/sso/callback,nodomain.freeyourgadget.gadgetbridge://endurain/oauth/callback
#ALLOWED_REDIRECT_URIS=com.endurain.endurain:/auth/sso/callback

# Optional: SSRF allowlist for admin-configured outbound calls (currently OIDC
# discovery and JWKS fetch only). Comma-separated list of exact hostnames
# (case-insensitive) and/or explicit IP CIDR ranges that may resolve to
# private/internal addresses. Use this to enable self-hosted identity providers
# (Authentik, Pocket ID, Keycloak, ...) reachable only over a private network.
# Examples:
#   SSRF_ALLOWED_HOSTS=auth.internal.example.com
#   SSRF_ALLOWED_HOSTS=auth.internal.example.com,10.10.0.0/24,fd00::/64
# Security:
#  - Wildcards ('*') are rejected.
#  - Overly broad CIDRs are rejected (IPv4 prefix must be >= /8, IPv6 >= /32).
#  - Every allowlisted outbound call is logged at INFO level for audit.
#  - The allowlist does NOT apply to other outbound calls (geocoding, etc.).
# Default: empty (no private destinations are ever dialed).
#SSRF_ALLOWED_HOSTS=

# Optional: extra origins appended to the Content-Security-Policy connect-src
# directive. Set this when Endurain is behind a forward-auth reverse proxy
# (e.g. Pangolin) that redirects API calls to its own domain for session
# validation, otherwise the browser blocks the redirect with a CSP error.
# Comma-separated CSP source expressions. Example:
#   CSP_ADDITIONAL_CONNECT_SRC=https://auth.example.com
# Use specific origins. Overly broad values that would defeat connect-src are
# rejected at startup: the bare wildcard '*' and scheme-only sources like
# 'https:' (host wildcards such as https://*.example.com are fine).
# Default: empty (connect-src stays 'self' + the jsDelivr CDN only).
#CSP_ADDITIONAL_CONNECT_SRC=

# If you change this, you also have to change DB_DATABASE
POSTGRES_DB=endurain
# Uncomment and set it to the same as POSTGRES_DB if you change it
# DB_DATABASE=endurain
# If you change this, you also have to change DB_USER
POSTGRES_USER=endurain
# Uncomment and set it to the same as POSTGRES_USER if you change it
# DB_USER=endurain
PGDATA=/var/lib/postgresql/data/pgdata

# Optional: Enable session timeouts (default: false)
# Deprecated in v0.21: the SESSION_* variables are imported into
# Settings > Server > Sessions on startup and are removed in v0.22.
# Enable idle session timeout
#SESSION_IDLE_TIMEOUT_ENABLED=true
# If enabled, configure timeout durations
# Idle timeout (no activity)
#SESSION_IDLE_TIMEOUT_HOURS=1
# Absolute max session lifetime
#SESSION_ABSOLUTE_TIMEOUT_HOURS=24

# Email configuration (for password reset functionality)
# Deprecated in v0.21: the SMTP_* variables are imported into
# Settings > Server > Email on startup and are removed in v0.22.
# Configure email in the admin settings and remove them.
#SMTP_HOST=smtp.protonmail.ch
#SMTP_PORT=587
#SMTP_USERNAME=your-email@example.com
#SMTP_PASSWORD=your-app-password
# SMTP_FROM sets the "From" address on outgoing emails.
# If unset, it is auto-detected (usually SMTP_USERNAME).
# Set this when your provider requires a verified sender
# that differs from the login username (e.g. Brevo).
#SMTP_FROM=your-verified-sender@example.com
#SMTP_SECURE=true
#SMTP_SECURE_TYPE=starttls

# Optional: Rate limiting configuration
# Disable rate limiting for development (default: true)
#RATE_LIMIT_ENABLED=true
