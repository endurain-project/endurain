# Generated test values for the load-test stack only. None of these protect anything real.
# Shared by every service of loadtest/compose.yaml.

# --- Endurain ---
ENDURAIN_HOST=http://localhost:18080
ENVIRONMENT=production
BEHIND_PROXY=true
# The Docker bridge ranges: the proxy is the only peer the replicas see, and it cannot be resolved by name while
# the replicas start beside it.
TRUSTED_PROXIES=172.16.0.0/12
LOG_LEVEL=warning
RATE_LIMIT_ENABLED=true

# --- Database ---
# Through toxiproxy (compose.yaml), which relays to the postgres service.
DB_HOST=toxiproxy
DB_PORT=5432
DB_USER=endurain
DB_DATABASE=endurain
# Per-process pool: small so a handful of replicas stay below max_connections of the postgres service.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
POSTGRES_USER=endurain
POSTGRES_DB=endurain

# --- Distributed deployment ---
DEPLOYMENT_PROFILE=distributed
WEB_WORKERS=1
REDIS_URL=redis://redis:6379/0
STORAGE_URI=s3://endurain-loadtest/files
LOCK_URI=postgres-advisory://
JOBS_ENABLED=true
JOBS_RUN_IN_PROCESS_WORKER=false
JOBS_POLL_INTERVAL_SECONDS=1
# The default attempts with short back-offs, so a job that meets a fault retries within seconds; a dead-letter is a
# finding (invariants.py).
JOBS_MAX_ATTEMPTS=5
JOBS_BACKOFF_BASE_SECONDS=1
JOBS_BACKOFF_MAX_SECONDS=5
# The shortest lease the application accepts, so a killed worker's jobs are requeued (by the reaper, every minute)
# within about two minutes (faults.py).
JOBS_LEASE_SECONDS=45

# --- Stub providers (compose.yaml, stub/stub.py) ---
# Map tiles, Nominatim and Strava resolve to the stub on the subnet below, which the SSRF guard would refuse.
SSRF_ALLOWED_HOSTS=172.29.77.0/24
# The system CAs plus the stub's CA, written by the stub at start.
SSL_CERT_FILE=/pki/ca-bundle.pem
REQUESTS_CA_BUNDLE=/pki/ca-bundle.pem

# --- S3 (adobe/s3mock) ---
AWS_ENDPOINT_URL=http://s3:9090
AWS_ACCESS_KEY_ID=loadtest-access
AWS_SECRET_ACCESS_KEY=loadtest-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_CONFIG_FILE=/loadtest/aws_config
