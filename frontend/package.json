{
  "name": "endurain",
  "version": "0.22.0-beta1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "run-s lint:check:oxlint lint:check:eslint",
    "lint:check:oxlint": "oxlint .",
    "lint:check:eslint": "eslint . --cache",
    "format": "prettier --write --experimental-cli src/",
    "format:check": "prettier --check --experimental-cli src/",
    "gen:api": "npx -y openapi-typescript@7.13.0 \"${ENDURAIN_OPENAPI_SOURCE:-openapi.json}\" --output src/types/api.generated.ts",
    "check": "run-s type-check lint:check format:check test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.73.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/vue-query": "^5.107.1",
    "@zxcvbn-ts/core": "4.3.0",
    "@zxcvbn-ts/language-common": "4.2.0",
    "@zxcvbn-ts/language-en": "4.1.2",
    "chart.js": "^4.6.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.18",
    "leaflet": "^1.9.4",
    "marked": "^18.2.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "simple-icons": "16.38.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@tsconfig/node24": "^24.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.94.0",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.94.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=26"
  }
}
