[importlinter]
# Run from backend/ with: PYTHONPATH=app uv run lint-imports
include_external_packages = True
root_packages =
    auth
    users
    activities
    core
    followers
    garmin
    gears
    health
    notifications
    server_settings
    strava
    websocket
    infra

[importlinter:contract:auth-boundary]
name = Auth boundary: non-auth must not import auth internals directly
type = forbidden
allow_indirect_imports = True
source_modules =
    users
    activities
    core
    followers
    garmin
    gears
    health
    notifications
    server_settings
    strava
    websocket
    infra
forbidden_modules =
    auth._internal
    auth.*.crud
    auth.*.*.crud

[importlinter:contract:platform-core-no-infra]
name = Platform core (providers/events/publisher/profile/container/runtime) must not import infrastructure directly
type = forbidden
allow_indirect_imports = True
source_modules =
    infra.providers
    infra.events
    infra.publisher
    infra.profile
    infra.capabilities
    infra.container
    infra.runtime
forbidden_modules =
    redis
    sqlalchemy
    boto3

[importlinter:contract:domain-not-platform-backends]
name = Domain modules must depend on platform providers, not backends
type = forbidden
allow_indirect_imports = True
source_modules =
    activities
    auth
    users
    followers
    garmin
    gears
    health
    notifications
    server_settings
    strava
    websocket
forbidden_modules =
    infra.backends

[importlinter:contract:platform-not-domain]
name = Platform substrate must not import domain modules
type = forbidden
allow_indirect_imports = True
source_modules =
    infra
forbidden_modules =
    activities
    auth
    users
    followers
    garmin
    gears
    health
    notifications
    server_settings
    strava
    websocket
ignore_imports =
    infra.jobs.router -> auth.dependencies
    infra.event_log.router -> auth.dependencies

[importlinter:contract:redis-owned-by-platform]
name = Only the platform Redis capability may import redis
type = forbidden
allow_indirect_imports = True
source_modules =
    activities
    auth
    core
    followers
    garmin
    gears
    health
    notifications
    server_settings
    strava
    users
    websocket
    infra
forbidden_modules =
    redis
ignore_imports =
    infra.redis -> redis
