[importlinter]
# Run from backend/ with: PYTHONPATH=app uv run lint-imports
include_external_packages = True
root_packages =
    modules
    core
    infra

[importlinter:contract:auth-boundary]
name = Auth boundary: non-auth must not import auth internals directly
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.users
    modules.activities
    core
    modules.followers
    modules.garmin
    modules.gears
    modules.health
    modules.notifications
    modules.server_settings
    modules.strava
    modules.websocket
    infra
forbidden_modules =
    modules.auth._internal
    modules.auth.*.crud
    modules.auth.*.*.crud

[importlinter:contract:platform-core-no-infra]
name = Platform core (providers/events/publisher/profile/container/runtime) must not import infrastructure directly
type = forbidden
allow_indirect_imports = True
source_modules =
    infra.providers
    infra.events
    infra.publisher
    infra.profile
    infra.capabilities
    infra.container
    infra.runtime
forbidden_modules =
    redis
    sqlalchemy
    boto3

[importlinter:contract:domain-not-platform-backends]
name = Domain modules must depend on platform providers, not backends
type = forbidden
allow_indirect_imports = True
source_modules =
    modules
forbidden_modules =
    infra.backends

[importlinter:contract:platform-not-domain]
name = Platform substrate must not import domain modules
type = forbidden
allow_indirect_imports = True
source_modules =
    infra
forbidden_modules =
    modules

# The same rule one layer up, for ``core``. ``core.scheduler`` used to import
# four activities internals plus auth, Strava and Garmin in order to enumerate
# their recurring jobs — the platform reaching up into the domain to ask what
# work exists. Each module now declares its own ``scheduled_jobs``, and the
# composition root (``main``) hands the collected list to ``start_scheduler``.
# Two exceptions remain, both reads of a domain SCHEMA (a data shape) rather
# than behaviour, and both recorded here so they are reviewed rather than
# assumed: ``core.middleware`` types the server settings it stamps onto the
# request, and ``core.i18n`` derives its supported-locale set from the users
# ``Language`` enum (lazily, to avoid a circular import). The i18n one is
# genuinely backwards — i18n owns which translation bundles exist — and is
# tracked in docs/developer-guide/module-structure.md.
[importlinter:contract:core-not-domain]
name = Core must not import domain modules
type = forbidden
allow_indirect_imports = True
source_modules =
    core
forbidden_modules =
    modules
ignore_imports =
    core.middleware -> modules.server_settings.schema
    core.i18n -> modules.users.users.schema

[importlinter:contract:redis-owned-by-platform]
name = Only the platform Redis capability may import redis
type = forbidden
allow_indirect_imports = True
source_modules =
    modules
    core
    infra
forbidden_modules =
    redis
ignore_imports =
    infra.redis -> redis

# A layers contract (not a denylist) that states the substrate's internal direction
# once: the composition root (container) sits above the adapters (backends), which sit
# above the ports (providers) and the event envelope (events). Higher layers may import
# lower ones, never the reverse — so a port importing an adapter (the ports-and-adapters
# inversion the forbidden contracts above do NOT catch) is rejected here.
[importlinter:contract:platform-ports-and-adapters]
name = Platform ports-and-adapters: adapters may import ports, never the reverse
type = layers
containers =
    infra
layers =
    container
    backends
    providers
    events

# The whole activities module is provider-agnostic, not just its core. Strava and
# Garmin depend on activities — they parse a provider payload and hand it to the
# ingestion seam — and activities used to depend on them right back:
# ``activity_ingestion.refresh_entry`` imported both provider clients,
# ``sources`` imported the Strava bulk-import helpers, and ``enrichment``
# imported Garmin to resolve synced gear. That cycle meant neither side could be
# built, tested or extracted without the other.
#
# The direction is now one-way, via three seams activities owns and providers
# plug into:
#   * ``activity_ingestion.provider_registry`` — a provider registers a fetch
#     callable at startup; the refresh path names no provider.
#   * ``activity_ingestion.sources.BulkImportSource`` — a provider export
#     subclasses it (``modules.strava.bulk_import_source``) instead of the base
#     class branching on ``strava_activities``.
#   * ``GarminSource.gear_id`` — the provider resolves its own synced gear and
#     passes the id, so enrichment only answers "and if not, what is the default?".
#
# This contract replaces the narrower ``activities-parsing-boundary`` and
# ``ingestion-pipeline-provider-agnostic`` provider clauses: stating it over the
# whole module means a new sub-package inherits it instead of having to be added
# to a list.
[importlinter:contract:activities-provider-agnostic]
name = The activities module must not import a provider — providers register with it
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.activities
forbidden_modules =
    modules.strava
    modules.garmin

# The activities core (activity/) is parsing-agnostic: it exposes the typed
# ParsedActivity contract + ingestion_service.store_parsed_activity, but never
# imports a file parser. All format knowledge lives in the sibling
# activity_ingestion/ package, which produces the contract and calls the core.
# Direct imports only (allow_indirect_imports): the rule is that the core must
# not reach for a parser directly, not that it must avoid transitive shared
# dependencies. The provider half of this boundary is now the module-wide
# ``activities-provider-agnostic`` contract above.
[importlinter:contract:activities-parsing-boundary]
name = Activities core must not import file parsers
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.activities.activity
forbidden_modules =
    modules.activities.activity_file_import

# The ingestion PIPELINE is provider-agnostic, the same way it is already
# format-agnostic. It owns "validate -> parse -> enrich -> store -> retain" and nothing
# about where a file came from: the export specifics (which duplicate listings to
# skip, what metadata to apply, the sidecar photos) are answered by the sources object it
# is handed. ``sources.py`` is deliberately NOT in scope here: defining the seam a
# provider export subclasses *is* its job.
# Superseded in the provider dimension by ``activities-provider-agnostic`` above;
# kept because it also forbids the pipeline reaching for the *parsers*, which is a
# different rule with the same shape.
[importlinter:contract:ingestion-pipeline-format-agnostic]
name = The ingestion pipeline must not import a parser directly — the registry resolves one
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.activities.activity_ingestion.upload_entry
    modules.activities.activity_ingestion.bulk_entry
    modules.activities.activity_ingestion.ingestion_jobs
    modules.activities.activity_ingestion.sources
forbidden_modules =
    modules.activities.activity_file_import

# The activities persistence layer answers with rows, never by asking another
# bounded context a question first. ``activity.crud`` used to resolve the
# requester's accepted followees (followers module) while building a visibility
# condition, read the server-wide shareable-links policy (server_settings) mid
# -``SELECT``, and ``activity_streams.crud`` loaded each owner (users) to scale
# HR zones — a service decision wearing a persistence layer's clothes, and three
# reasons a query could not be reasoned about, tested, or reused without three
# other modules present.
#
# Those values are now resolved by the layer above and passed in: ``followee_ids``
# on the visibility filter, the policy check in ``activity.service`` /
# ``activity.child_access``, and the HR-zone loop in ``activity_streams.service``.
# Schemas stay allowed — a shape is not a question.
[importlinter:contract:activities-persistence-asks-nothing]
name = Activities persistence must not call another module
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.activities.*.crud
    modules.activities.activity.query
    modules.activities.activity.serializers
    modules.activities.*.utils
forbidden_modules =
    modules.users.users.integration_service
    modules.followers.integration_service
    modules.server_settings.integration_service
    modules.notifications.integration_service
    modules.websocket.integration_service
    modules.gears
    modules.auth

# The file parsers (activity_file_import/) are PURE: bytes -> parsed dict/Activity, with no
# db, privacy, gear, provider, or exercise-title-crud coupling. Every bit
# of domain resolution they used to do inline (default/Garmin gear, privacy defaults,
# exercise-title persistence) now lives in the sibling activity_ingestion/ enrichment seam,
# which legitimately owns db + provider knowledge — so a parser is unit-testable with bytes
# alone. The parsers may still import the activities SCHEMAS (activity.schema /
# activity_exercise_titles.schema / activity_workout_steps.schema) — data shapes, not crud.
[importlinter:contract:activity-file-import-purity]
name = Activity file parsers must be pure (no db / domain / provider / crud / HTTP imports)
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.activities.activity_file_import
forbidden_modules =
    modules.gears
    modules.users
    modules.garmin
    modules.strava
    modules.activities.*.crud
    modules.activities.*.*.crud
    sqlalchemy
    fastapi

# The activities module performs no raw network egress. Reverse geocoding was the
# one exception: it built provider URLs, resolved and denylisted the configured
# host against SSRF (OWASP A10), and spoke HTTP — none of which is a fact about
# activities, and all of which protected exactly one call site. That now sits
# behind the platform GeocodingProvider, with the host checks in infra.egress
# where a future outbound integration inherits them instead of reimplementing
# them. This contract is what stops the egress code drifting back into the domain:
# an outbound call from activities must be added as a platform provider.
# Note: ``urllib`` is deliberately not listed. import-linter cannot forbid a
# single subpackage of an external/stdlib package, and activities legitimately
# uses ``urllib.parse`` for URL decoding — banning the parent would reject that
# too. The HTTP clients actually in use here are covered.
[importlinter:contract:activities-no-raw-egress]
name = The activities module must not make raw network calls
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.activities
forbidden_modules =
    requests
    httpx
    socket
    staticmap

# The consumer modules — the providers (Strava, Garmin), gears, and users — must not
# reach into any activities CRUD or its ORM directly. They go through the curated
# activity integration_service interface (activity/integration_service.py), the
# read/gear/aggregate/delete counterpart to the ingestion seam they already use to
# STORE activities. Going through the interface is what keeps the activities tables
# queried only by their owner, and what makes bulk deletes emit the cleanup events
# that reclaim thumbnails and stored source files.
# The forbidden list is a WILDCARD over every activities sub-package, not just the
# parent: naming ``activity.crud`` alone left the profile export/import reaching into
# five CHILD cruds (laps, sets, streams, workout steps, exercise titles, media) and the
# users CRUD into activity_streams — the same boundary violation the contract exists to
# stop, one level down. Those consumers now call the child operations the integration
# service exposes.
# allow_indirect_imports keeps this to DIRECT imports: the interface itself
# legitimately imports crud (it is inside activities), so the transitive
# consumer -> integration_service -> crud path is fine — only a bare
# `import modules.activities.<pkg>.crud` in a consumer module is rejected.
[importlinter:contract:consumer-activities-boundary]
name = Consumer modules must use the activities integration service, not activities CRUD
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.strava
    modules.garmin
    modules.gears
    modules.users
forbidden_modules =
    modules.activities.*.crud
    modules.activities.*.*.crud
    modules.activities.activity.query

# The companion ORM rule, stated structurally so it can exclude one thing: ORM
# models legitimately reference each other across modules, because SQLAlchemy
# relationships share a single registry and are typed with TYPE_CHECKING imports
# (``Gear`` <-> ``Activity`` <-> ``Users``). What must NOT happen is a consumer's
# *behaviour* layer querying the activities table itself — which is exactly how
# the gear and gear-component usage totals used to be computed, complete with
# their own copy of the local-timezone date rule. Those aggregations now live in
# the activities module and are reached through the integration service.
[importlinter:contract:consumer-activities-orm]
name = Consumer behaviour layers must not query the activities ORM directly
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.strava
    modules.garmin
    modules.gears.*.crud
    modules.gears.*.service
    modules.users.*.crud
    modules.users.*.utils
    modules.users.users_profile.export_service
    modules.users.users_profile.import_service
forbidden_modules =
    modules.activities.activity.models

# Provider modules describe users data with the read schemas the users CRUD actually
# returns, never the ORM models. The annotations used to name the ORM classes even
# though the runtime value was already a DTO, which kept a users-ORM import alive
# inside Strava/Garmin for no reason.
[importlinter:contract:providers-no-users-orm]
name = Provider modules must not import the users ORM models
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.strava
    modules.garmin
forbidden_modules =
    modules.users.users_integrations.models
    modules.users.users_privacy_settings.models

# The activities core consumes the followers module through the curated
# followers.integration_service interface (list_accepted_followee_ids) — used by both
# the feed routes and the non-owner visibility filter — never by reaching into the
# followers ORM/CRUD, and never into followers.service either. That last one matters:
# ``service`` is the followers module's OWN application layer (privacy-checked reads,
# follow/accept/unfollow writes, notification publishes), almost none of which means
# anything to a caller outside the module. Naming the cross-module surface
# ``integration_service`` in every module makes "what may I depend on?" have one answer
# everywhere instead of being ``integration_service`` here and ``service`` there.
# allow_indirect_imports keeps this to DIRECT imports: integration_service legitimately
# imports followers.crud, so the transitive
# activities -> followers.integration_service -> followers.crud -> followers.models
# path is fine.
[importlinter:contract:activities-followers-boundary]
name = Activities must use the followers integration service, not its ORM/CRUD/service
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.activities
forbidden_modules =
    modules.followers.models
    modules.followers.crud
    modules.followers.service

# Routers are transport adapters: they validate, delegate to the module's service, and
# return. They hold no domain rule and no persistence orchestration. This is what the
# activities router was violating — it owned the delete's commit/publish ordering, the
# bulk-edit "an empty body is a client bug" rule, and a bare HTTPException sitting next
# to siblings that raise domain errors. Forbidding crud/models/event_publishers makes
# "call the service" the only remaining option rather than a convention the next
# handler can quietly drop.
# Stated as a WILDCARD over every activities sub-package rather than a hand-listed
# pair. Listing modules meant the rule only applied where someone remembered to add
# them, and the sibling sub-resource routers (laps, sets, streams, workout steps,
# exercise titles) went straight to their own crud — which is also where their access
# checks lived. Each now has a service.py, so the rule is general, and a new
# sub-package inherits it instead of having to opt in.
[importlinter:contract:activities-router-delegates]
name = Activities routers delegate to the service — no CRUD, ORM or event publishing
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.activities.*.router
    modules.activities.*.public_router
forbidden_modules =
    modules.activities.*.crud
    modules.activities.*.models
    modules.activities.*.query
    modules.activities.*.event_publishers
    modules.activities.activity_ingestion.ingestion_jobs_crud

# ORM ownership: the activities ORM models are owned by their subpackage's models.py
# and touched only by the persistence layer — crud.py (the single ORM surface) and the
# ORM->schema transformation helpers (activity/serializers.py, activity_streams/utils.py,
# which receive ORM rows FROM crud and return schemas/primitives). The application layers
# — service, router, public_router, subscribers, event_publishers, stats — must never
# reach for an ORM model directly; they go through crud (which returns schemas/DTOs). This
# is what caught the thumbnail service loading stream ORM rows directly instead of via a
# streams CRUD projection. allow_indirect_imports keeps this to DIRECT imports: a service
# importing crud (which imports models) is fine; a bare `import modules.activities.X.models`
# in a consumer layer is rejected.
[importlinter:contract:activities-orm-ownership]
name = Activities ORM models stay in the persistence layer — application layers must not import them
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.activities.*.service
    modules.activities.*.subscribers
    modules.activities.*.router
    modules.activities.*.public_router
    modules.activities.*.event_publishers
    modules.activities.*.stats
forbidden_modules =
    modules.activities.*.models

# The persistence layer describes what went wrong in the domain, not which HTTP
# status to send. The activities and followers CRUD modules raised
# ``fastapi.HTTPException`` for 404/409/422, and ``core.decorators.handle_db_errors``
# raised it for every database failure — so the durable-job worker, which serves no
# HTTP at all, handled a dropped connection by constructing an HTTP response, and
# ``ingestion_service`` had to catch both exception families to guarantee a rollback.
# They now raise ``core.exceptions``; the single handler registered on the app turns
# those into responses. Forbidding fastapi outright (not just HTTPException, which
# import-linter cannot express) is what keeps a ``status`` or ``Depends`` from being
# the next thing to leak in.
# Stated as a wildcard so a new activities sub-package's crud is covered the day it
# is written, rather than when someone remembers to add it to a list.
[importlinter:contract:persistence-no-http]
name = Activities and followers persistence raises domain errors, not HTTP ones
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.activities.*.crud
    modules.activities.activity.query
    modules.activities.activity.serializers
    modules.followers.crud
forbidden_modules =
    fastapi

# The child sub-resources (laps, sets, streams, workout steps, exercise titles) decide
# access in their SERVICE, through the shared activity/child_access gate — never in
# their crud. Each crud used to answer "may this caller read these rows?" itself,
# inline above its SELECT: four copies of one access-control rule, living in the layer
# a reviewer looking for authorization would not think to open. This contract is what
# stops a fifth copy appearing — a child crud that cannot import the activities core's
# crud has nowhere to make the decision.
[importlinter:contract:activities-child-access-gate]
name = Activity child CRUDs hold no access rule — the shared gate decides
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.activities.activity_exercise_titles.crud
    modules.activities.activity_laps.crud
    modules.activities.activity_sets.crud
    modules.activities.activity_streams.crud
    modules.activities.activity_workout_steps.crud
forbidden_modules =
    modules.activities.activity.crud
    modules.activities.activity.child_access

# One level up, the same rule for the SERVICES. Laps, sets and workout steps are
# one read three times over — check the gate, page the rows, count them, wrap
# them, and answer a refusal exactly like an empty collection. Each held its own
# copy, ~98% identical after renaming the resource, and the copies had already
# drifted. They now declare what they are (hide flag + CRUD pair + page type) and
# hand the read to ``activity/child_collection``.
# Forbidding the gate is what keeps that true: a service that cannot call
# ``child_access`` cannot quietly grow a fourth copy of the read around it.
# ``activity_streams.service`` is deliberately absent — its masking is per stream
# *type* rather than one flag, so it resolves the parent and applies its own
# filter, which is a different read rather than a copy of this one.
[importlinter:contract:activities-child-collection-shared]
name = Activity child services use the shared paginated read, not their own gate call
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.activities.activity_laps.service
    modules.activities.activity_sets.service
    modules.activities.activity_workout_steps.service
forbidden_modules =
    modules.activities.activity.child_access
    modules.activities.activity.crud

# The counterpart to consumer-activities-boundary, pointing the other way: the
# activities module consumes users through the curated users integration service
# (users/users/integration_service.py), never by reaching into the users CRUD or
# its utility grab-bag. It previously imported four separate users internals —
# including users.users.utils, which drags in FastAPI, the file-upload helpers
# and the health-targets CRUD for a caller that only wanted a timezone. Schemas
# stay allowed (data shapes, not behaviour), as do the FastAPI dependencies the
# routers mount, which are an HTTP-boundary concern rather than a domain reach.
# The users ORM is also not listed: SQLAlchemy relationships share one registry and
# are typed with TYPE_CHECKING imports (``Activity`` <-> ``Users``), so the model
# cross-reference is structural rather than a behaviour-layer reach — the same
# exception consumer-activities-orm makes in the opposite direction.
# allow_indirect_imports keeps this to DIRECT imports: the interface itself
# legitimately imports users crud/utils, so activities -> integration_service ->
# crud is fine.
[importlinter:contract:consumer-users-boundary]
name = Activities must use the users integration service, not the users CRUD/utils
type = forbidden
allow_indirect_imports = True
source_modules =
    modules.activities
forbidden_modules =
    modules.users.users.crud
    modules.users.users.utils
    modules.users.users_privacy_settings.crud
    modules.users.users_privacy_settings.utils
    modules.users.users_default_gear.crud
    modules.users.users_default_gear.utils
